{
  "description": "Start CodexControlPlugin when a Codex session starts or resumes.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'CodexControlPlugin currently supports Windows only'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/session-start.ps1\"",
            "timeout": 15,
            "statusMessage": "Starting CodexControlPlugin"
          }
        ]
      }
    ]
  }
}
